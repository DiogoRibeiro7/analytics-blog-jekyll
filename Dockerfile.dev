# DataLog Jekyll Theme - Development Environment
# ===============================================
# Image for local development with live reload
#
# Usage:
#   docker build -f Dockerfile.dev -t datalog-dev .
#   docker run -p 4000:4000 -v $(pwd):/app datalog-dev
#
# Or use docker-compose:
#   docker-compose up

FROM ruby:3.2-slim AS base

# Install system dependencies. libssl-dev and libyaml-dev: with no Gemfile.lock,
# Bundler resolves gems such as openssl and psych that compile against these
# headers, which the slim image does not ship.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    libssl-dev \
    libyaml-dev \
    libvips \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 LTS from NodeSource, the version CI uses. The image also
# installed Debian's nodejs and npm packages, which this replaced anyway.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy dependency files. The Gemfile loads the gemspec, which requires
# version.rb and package.rb; without them `bundle install` failed here.
COPY Gemfile datalog-theme.gemspec ./
COPY lib/datalog/theme/version.rb lib/datalog/theme/package.rb lib/datalog/theme/
COPY package.json package-lock.json ./

# Install Ruby dependencies
RUN bundle install

# Install Node.js dependencies
RUN npm ci

# Copy application files
COPY . .

# Expose Jekyll default port
EXPOSE 4000

# Expose LiveReload port
EXPOSE 35729

# Set environment variables
ENV JEKYLL_ENV=development
ENV NODE_ENV=development

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:4000/ || exit 1

# Default command: Start Jekyll server with live reload
CMD ["bundle", "exec", "jekyll", "serve", "--host", "0.0.0.0", "--livereload", "--incremental", "--trace"]
