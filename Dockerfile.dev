# DataLog Jekyll Theme - Development Environment
# ===============================================
# Multi-stage Docker image for local development with hot-reload support
#
# Usage:
#   docker build -f Dockerfile.dev -t datalog-dev .
#   docker run -p 4000:4000 -v $(pwd):/app datalog-dev
#
# Or use docker-compose:
#   docker-compose up

FROM ruby:3.2-slim AS base

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    libvips \
    nodejs \
    npm \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install global Node packages
RUN npm install -g npm@latest

# Copy dependency files
COPY Gemfile* ./
COPY package*.json ./
COPY requirements.txt ./

# Install Ruby dependencies
RUN bundle install

# Install Node.js dependencies
RUN npm ci

# Install Python dependencies for Jupyter support
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Copy application files
COPY . .

# Expose Jekyll default port
EXPOSE 4000

# Expose LiveReload port
EXPOSE 35729

# Set environment variables
ENV JEKYLL_ENV=development
ENV NODE_ENV=development

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:4000/ || exit 1

# Default command: Start Jekyll server with live reload
CMD ["bundle", "exec", "jekyll", "serve", "--host", "0.0.0.0", "--livereload", "--incremental", "--trace"]
