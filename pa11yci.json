{
  "defaults": {
    "timeout": 60000,
    "wait": 1000,
    "standard": "WCAG2AA",
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ]
    }
  },
  "urls": [
    {
      "url": "http://localhost:4000/index.html",
      "hideElements": ".hero-tagline"
    },
    "http://localhost:4000/blog/index.html",
    "http://localhost:4000/visualizations/index.html",
    "http://localhost:4000/portfolio/index.html"
  ]
}
