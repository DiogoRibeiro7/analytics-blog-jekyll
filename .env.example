# DataLog Jekyll Theme - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Google Analytics 4 Configuration (Optional)
# ============================================
# Required for analytics dashboard functionality
# Leave empty to disable analytics features

# Your GA4 Property ID (format: G-XXXXXXXXXX)
GA4_PROPERTY_ID=

# Service account credentials (choose ONE of the following):
# Option 1: Raw JSON credentials as a single-line string
GA4_CREDENTIALS_JSON=

# Option 2: Path to credentials JSON file
GA4_CREDENTIALS_PATH=

# Alternatively, configure in _config.yml under analytics.ga4_property_id

# ============================================
# Testing & CI/CD
# ============================================

# Playwright Base URL (Required for integration/visual tests)
# URL where the Jekyll site is served for testing
# Example: http://localhost:4000 or http://127.0.0.1:4173
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173

# Codecov Token (Optional - for test coverage reporting)
# Get this from https://codecov.io after linking your repository
# Coverage uploads will skip if not provided
CODECOV_TOKEN=

# ============================================
# Build Environment
# ============================================

# Jekyll environment (development, production)
# Set to 'production' for optimized builds
JEKYLL_ENV=development

# Node environment (development, test, production)
NODE_ENV=development

# Skip browser downloads for CI environments
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=0

# ============================================
# Development Settings
# ============================================

# Enable/disable specific features during development
# (These can also be configured in _config.yml)

# GitHub Repository (for repository metrics)
# Format: username/repository
# GITHUB_REPOSITORY=DiogoRibeiro7/analytics-blog-jekyll

# ============================================
# Notes
# ============================================
# - Never commit the actual .env file to version control
# - Add .env to .gitignore (already configured)
# - For GitHub Actions, add secrets in repository settings
# - See docs/configuration-reference.md for more details
