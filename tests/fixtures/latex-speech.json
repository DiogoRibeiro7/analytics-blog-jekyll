[
  { "about": "The demo's maths article, whose labels lost their commands (#417)" },
  { "latex": "f : [a, b] \\to \\mathbb{R}", "label": "f: [a, b] to double-struck R" },
  { "latex": "c \\in (a, b)", "label": "c in (a, b)" },
  { "latex": "f''(c) + \\frac{\\pi^2}{(b-a)^2} f(c) = 0", "label": "f double prime (c) + pi squared over (b-a) squared f(c) = 0" },
  { "latex": "g(x) = \\sin\\left(\\frac{\\pi(x-a)}{b-a}\\right)", "label": "g(x) = sin (pi (x-a) over b-a)" },
  { "latex": "\ng''(x) = -\\frac{\\pi^2}{(b-a)^2}\\, g(x),\n", "label": "g double prime (x) = - pi squared over (b-a) squared g(x)" },
  { "latex": "\\begin{equation}\\label{eq:ibp}\n\\int_a^b f'(x) g'(x) \\, \\mathrm{d}x = -\\int_a^b f(x) g''(x) \\, \\mathrm{d}x\n\\end{equation}", "label": "integral from a to b f prime (x) g prime (x) d x = - integral from a to b f(x) g double prime (x) d x" },
  { "latex": "\\square", "label": "square" },
  { "latex": "\\int_a^b f(x)\\,\\mathrm{d}x", "label": "integral from a to b f(x) d x" },

  { "about": "Relations, arrows and logic" },
  { "latex": "a \\leq b \\neq c \\approx d", "label": "a less than or equal to b not equal to c approximately equal to d" },
  { "latex": "A \\subseteq B \\implies x \\notin C", "label": "A subset of or equal to B implies x not in C" },
  { "latex": "x \\mapsto x^2", "label": "x maps to x squared" },
  { "latex": "\\forall \\epsilon > 0 \\, \\exists \\delta", "label": "for all epsilon > 0 there exists delta" },
  { "latex": "P(A \\mid B)", "label": "P(A given B)" },

  { "about": "Greek letters, letter styles and accents" },
  { "latex": "\\alpha + \\Omega + \\varepsilon", "label": "alpha + capital omega + epsilon" },
  { "latex": "\\mathcal{L}(\\theta) + \\mathbf{x}", "label": "script L (theta) + bold x" },
  { "latex": "\\hat{\\beta} = \\bar{x} + \\vec{v}", "label": "beta hat = x bar + vector v" },

  { "about": "Fractions, roots and scripts, nested" },
  { "latex": "\\frac{1}{\\sqrt{2\\pi\\sigma^2}}", "label": "1 over square root of 2 pi sigma squared" },
  { "latex": "\\sqrt[3]{x} + \\sqrt[n]{y}", "label": "cube root of x + nth root of y" },
  { "latex": "\\binom{n}{k}", "label": "n choose k" },
  { "latex": "x_i^3 + e^{i\\pi}", "label": "x sub i cubed + e to the power i pi" },
  { "latex": "(X^\\top X)^{-1} X^T y", "label": "(X transpose X) inverse X transpose y" },
  { "latex": "90^\\circ", "label": "90 degrees" },
  { "latex": "\\overbrace{a+b}^{n} + \\underbrace{x+y}_{\\text{sum}} + \\overbrace{c}", "label": "a+b with n above + x+y with sum below + c" },

  { "about": "Big operators and limits" },
  { "latex": "\\int_{0}^{1} x^2 \\, dx = \\frac{1}{3}", "label": "integral from 0 to 1 x squared dx = 1 over 3" },
  { "latex": "\\sum_{i \\in S} x_i", "label": "summation over i in S x sub i" },
  { "latex": "\\prod_{k=1}^{n} k", "label": "product from k=1 to n k" },
  { "latex": "\\lim_{x \\to 0} \\frac{\\sin x}{x} = 1", "label": "limit as x approaches 0 sin x over x = 1" },
  { "latex": "\\max_{i} a_i", "label": "max over i a sub i" },

  { "about": "Functions and text" },
  { "latex": "\\log x + \\exp(y)", "label": "log x + exp (y)" },
  { "latex": "\\operatorname{Var}(X)", "label": "Var (X)" },
  { "latex": "x = 1 \\text{ if it's set}", "label": "x = 1 if it's set" },
  { "latex": "50\\% \\pmod{7}", "label": "50 percent mod 7" },

  { "about": "Sizing, spacing, labels, tags and environment names are left out" },
  { "latex": "\\left\\{ x \\in \\mathbb{R} : x \\geq 0 \\right\\}", "label": "{x in double-struck R: x greater than or equal to 0}" },
  { "latex": "\\left. f \\right|_{0}", "label": "f | sub 0" },
  { "latex": "a \\quad b \\; c \\! d", "label": "a b c d" },
  { "latex": "x = 1 \\tag{3} \\label{eq:one}", "label": "x = 1" },
  { "latex": "\\begin{align*} a &= b \\\\ c &= d \\end{align*}", "label": "a = b; c = d" },
  { "latex": "\\begin{array}{cc} 1 & 2 \\end{array}", "label": "1 2" },
  { "latex": "\\displaystyle \\color{red}{x}", "label": "x" },

  { "about": "Matrices and cases" },
  { "latex": "\\begin{pmatrix} a & b \\\\ c & d \\end{pmatrix}", "label": "matrix a, b; c, d end matrix" },
  { "latex": "\\begin{bmatrix*} 1 & 0 \\end{bmatrix*}", "label": "matrix 1, 0 end matrix" },
  { "latex": "|x| = \\begin{cases} x & x \\geq 0 \\\\ -x & x < 0 \\end{cases}", "label": "|x| = cases x, x greater than or equal to 0; -x, x < 0 end cases" },

  { "about": "A command no table knows is read by its name" },
  { "latex": "\\foo{x} + \\widecheck{y}", "label": "foo x + widecheck y" },

  { "about": "Comments, empty input and broken input" },
  { "latex": "% alt: not the label\nx = 1 % a note", "label": "x = 1" },
  { "latex": "", "label": "" },
  { "latex": "{{{{", "label": "" },
  { "latex": "\\frac{a}{", "label": "a over" },
  { "latex": "x \\", "label": "x" }
]
