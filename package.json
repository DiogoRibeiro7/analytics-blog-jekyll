{
  "name": "analytics-blog-jekyll",
  "version": "1.0.0",
  "description": "Performance tooling for the DataLog Jekyll theme.",
  "type": "module",
  "scripts": {
    "build:js": "node ./scripts/build_js.mjs",
    "build:critical": "node ./scripts/extract_critical_css.js",
    "build:assets": "npm run build:js",
    "generate-sri": "node scripts/generate_sri.js",
    "validate-sri": "node scripts/validate_sri.js",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage --run && node scripts/check_coverage.js",
    "test:integration": "node ./scripts/run_playwright_suite.js",
    "test:integration:direct": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:visual:auto": "node ./scripts/run_playwright_suite.js --grep @visual",
    "test:visual:percy": "percy exec -- node ./scripts/run_playwright_suite.js --grep @visual",
    "lint": "eslint assets/js/ scripts/ tests/",
    "lint:fix": "eslint --fix assets/js/ scripts/ tests/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@percy/cli": "^1.32.7",
    "@percy/playwright": "^1.1.2",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "critical": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "vitest": "^4.0.12",
    "wait-on": "^9.1.0",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix"
    ],
    "*.{json,yml,yaml}": [
      "echo '✓ Checked config file:'"
    ],
    "*.md": [
      "echo '✓ Checked documentation file:'"
    ]
  }
}
